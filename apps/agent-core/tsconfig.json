{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "core/**/*.ts",
    "context/**/*.ts",
    "router/**/*.ts",
    "skills/**/*.ts",
    "tools/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts"
  ]
}
