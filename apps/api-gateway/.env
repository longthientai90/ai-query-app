API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
API_GATEWAY_CORS_ORIGINS=*

# Standalone agent-core HTTP endpoint
AGENT_CORE_BASE_URL=http://127.0.0.1:8100
AGENT_CORE_HANDLE_PATH=/agent/handle
AGENT_CORE_TIMEOUT_SEC=120

