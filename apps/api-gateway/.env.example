API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
API_GATEWAY_CORS_ORIGINS=*

# Standalone agent-core HTTP endpoint
AGENT_CORE_BASE_URL=http://127.0.0.1:8100
AGENT_CORE_HANDLE_PATH=/agent/handle
AGENT_CORE_TIMEOUT_SEC=120

# Azure OpenAI for chart suggestion
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Chart.js MCP server via stdio
CHART_MCP_COMMAND=npx
CHART_MCP_ARGS=-y @ax-crew/chartjs-mcp-server

# OpenTelemetry tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=always_on
